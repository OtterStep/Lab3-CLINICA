        "jsCode": "const data = items[0].json.body;\nlet mensaje = `📋 *Reporte de Triajes - ${data.fecha}*\\n\\n`;\n\ndata.pacientes.forEach(p => {\n    mensaje += `👤 *${p.nombre}*\\n   🚩 Urgencia: ${p.urgencia.toUpperCase()}\\n   🩺 Obs: ${p.diagnostico}...\\n\\n`;\n});\n\nreturn [{json: {mensaje, chat_id: data.chat_id}}];"
